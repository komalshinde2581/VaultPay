# VaultPay Environment Variables Configuration Example
# Copy this file to .env and configure secrets accordingly.

# Server & Networking
PORT=8080
FRONTEND_PORT=3000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vaultpay
DB_USER=vaultpay_user
DB_PASSWORD=vaultpay_secure_password
MYSQL_ROOT_PASSWORD=vaultpay_root_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Security & JWT Secrets (Must be at least 32 characters in production)
JWT_SECRET=4c7365637572655f7661756c747061795f66696e746563685f6a77745f7365637265745f6b65795f32303236
ACCESS_TOKEN_EXPIRATION_MS=900000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Fraud Detection Engine Parameters
FRAUD_LARGE_TRANSFER_THRESHOLD=10000.00
FRAUD_RAPID_TRANSFER_COUNT=3
FRAUD_RAPID_WINDOW_MINUTES=5
FRAUD_DAILY_VELOCITY_LIMIT=25000.00

# Beneficiary Cooling Rules
BENEFICIARY_COOLING_HOURS=24
BENEFICIARY_INITIAL_LIMIT=1000.00
